# Shen-Backpressure manifest (Elixir). Generated by `sb init --lang elixir`.
#
# Gate order: gen → compile (warnings are errors, guard tracer active)
# → test → shen tc+ (shen-erl) → tcb audit. `sb gates` appends
# shen-derive ([[derive.specs]]) and mutate-spec ([mutate]).

[project]
lang = "elixir"
pkg  = "{{.Pkg}}"

[paths]
spec   = "{{.Spec}}"
output = "{{.Output}}"

[elixir]
tracer_out = "shen/guard_tracer.ex"
# ash_out     = "lib/<app>/shen/policy_gen.ex"   # Ash policy checks for *-access rules
# ash_targets = ["tenant-access"]

[[gates]]
name = "shengen"
run  = "sb gen"

[[gates]]
name = "build"
run  = "mix compile --warnings-as-errors"

[[gates]]
name = "test"
run  = "mix test"

[[gates]]
name = "shen-check"
run  = "./bin/shen-check.sh"

[[gates]]
name = "tcb-audit"
run  = "sb audit"

# shen-derive for Elixir: write the impl, then `sb derive --regen`.
# [[derive.specs]]
# lang      = "elixir"
# path      = "specs/core.shen"
# func      = "within-limit?"
# impl_pkg  = "{{.Pkg}}Impl"        # your module
# impl_func = "within_limit?"
# guard_pkg = "{{.Pkg}}"
# out_file  = "test/derived/within_limit_spec_test.exs"

[mutate]
prelude = ["specs/verified.shen"]
hostile = ["specs/hostile/*.shen"]
good    = ["specs/good/*.shen"]
# shen = "shen-erl"      # or $SB_SHEN / $SHEN_ERL_ROOT

[loop]
harness  = "claude -p"
max_iter = 10
timeout  = "10m"
prompt   = "prompts/main_prompt.md"
plan     = "plans/fix_plan.md"
