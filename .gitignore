# Claude Code local files
.claude/

# Built binaries
demo/*/ralph
demo/*/bin/shen
demo/*/server
bin/shengen
bin/shen-derive
bin/sb
cmd/shengen/shengen
cmd/sb/bin/
cmd/sb/sb
# cmd/sb/skilldata/ — embedded in binary, kept in sync with sb/
# bin/shengen-ts and bin/shen-derive-ts are static shell wrappers, committed

# Databases and WAL files
*.db
*.db-shm
*.db-wal

# Rodney / Chrome automation artifacts
.rodney/

# Backpressure logs (generated at runtime)
demo/*/plans/backpressure.log

# Wave 4 discharge reports — local-only audit trail.
# .sb/discharge_report.json is rewritten on every gate run; .sb/history/
# accumulates time-stamped copies. Both are per-clone state, not source.
.sb/

# Allow-list: committed audit artifacts under each example's transcript/
# directory. These are static snapshots a reader can inspect on GitHub
# without cloning + installing Shen. Regenerate with:
#   (cd examples/<name> && sb gates && cp .sb/discharge_report.json transcript/
#    && sb audit-report > transcript/audit_report.md)
!examples/*/transcript/discharge_report.json
!examples/*/transcript/audit_report.md

# Repomix output
repomix-output.xml

# Python
__pycache__/
*.pyc

# Node.js
node_modules/
dist/
