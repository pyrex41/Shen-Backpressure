// sb-forgery: expect succeeds (documented TCB limit)
// sb-forgery-entry: ForgedTenantName
//
// Attempt #3: forge a TenantAccess via unsafe reflection.
//
// Outcome: the Go compiler accepts this, and at runtime the reflection
// path SUCCEEDS — `unsafe.Pointer` plus `reflect.NewAt` can write to
// any field regardless of export status. This is the honest limit of
// the structural guarantee in Go: the type system stops *normal* code
// from forging a guard value, but a determined attacker with the
// ability to use `unsafe` can bypass field visibility.
//
// Why we include this anyway:
//
//   1. The Go community treats `unsafe.Pointer` access to other
//      packages' unexported fields as a code-review red flag of the
//      same severity as `eval()` in scripting languages. A reviewer
//      who finds this idiom in a PR rejects it on sight.
//
//   2. The bypass is loud and grep-able. `grep -rn "unsafe.Pointer"
//      examples/multi-tenant-api/internal/` returns nothing in the
//      committed code; if it ever returns anything, the auditor knows
//      where to look.
//
//   3. The Go runtime can be built with -gcflags "-d=checkptr" /
//      -race / -tags purego variants that catch some unsafe misuse.
//
//   4. The companion guarantee — that NO ONE who doesn't already have
//      `unsafe.Pointer` privileges can forge a guard — is the
//      structural part of the trust model. It's described as
//      "structural" in docs/TRUST-MODEL.md, not "impossible-in-Go."
//
// bin/show-bypass-attempts.sh runs this file and reports that it
// *compiles and runs* but generates an "unsafe.Pointer" line that the
// audit grep would flag.
//
// W1 NOTE (brands). Brands do not help here, and neither does the
// witness: `unsafe` can set the `valid` field as easily as `isMember`,
// so this attempt still compiles and still succeeds. It names a brand
// only to keep compiling. The honest statement is unchanged — the
// defence against `unsafe` is review and grep, not the type system.
package bypass_attempts_demo

import (
	"reflect"
	"unsafe"

	"multi-tenant-api/internal/shenguard"
)

// attemptBrand is this attempt's GDP brand. Each .go.bak is staged
// alone, so every file that needs a brand declares its own.
type attemptBrand struct{}

// ForgeViaReflect builds a TenantAccess by writing directly to the
// unexported fields of an existing zero-valued instance via unsafe
// pointers. This is the literal "type system bypass" — and it is
// also the kind of code that any reviewer would reject on sight.
func ForgeViaReflect() shenguard.TenantAccess[attemptBrand] {
	var ta shenguard.TenantAccess[attemptBrand]
	v := reflect.ValueOf(&ta).Elem()

	// Set isMember = true via unsafe pointer arithmetic. Each line
	// crosses Go's normal visibility boundary on purpose; in a real
	// code review the `unsafe.Pointer` call below is the obvious
	// rejection signal.
	// W1 NOTE (brands). The generated struct's first field is an
	// unexported `valid witness`, and every accessor calls
	// mustBeMinted, so a value no constructor produced panics the
	// first time anything reads it. `unsafe` defeats that too:
	// `witness` is `struct{ minted bool }`, so writing the bool at
	// that field's address mints the forgery. This is the honest
	// statement of the limit — the witness panic stops dropped errors
	// and empty literals, not `unsafe`.
	validField := v.FieldByName("valid")
	*(*bool)(unsafe.Pointer(validField.UnsafeAddr())) = true

	isMemberField := v.FieldByName("isMember")
	*(*bool)(unsafe.Pointer(isMemberField.UnsafeAddr())) = true

	tenantField := v.FieldByName("tenant")
	tenantPtr := (*shenguard.TenantId)(unsafe.Pointer(tenantField.UnsafeAddr()))
	*tenantPtr = shenguard.NewTenantId("t-acme")

	return ta
}

// ForgedTenantName is the gate's entry point. It reads the forged
// value through the generated accessor, which is where the W1 witness
// would panic if the forgery had left it unminted. It does not panic,
// and that is the finding: `unsafe` is outside what the type system
// and the witness can reach, which is why this file declares
// `succeeds (documented TCB limit)` rather than any of the outcomes
// that mean "caught".
func ForgedTenantName() string {
	return ForgeViaReflect().Tenant().Val()
}
